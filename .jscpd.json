{
  "threshold": 1.52,
  "mode": "strict",
  "minLines": 5,
  "minTokens": 50,
  "maxLines": 500,
  "formats": ["javascript", "typescript"],
  "reporters": ["console", "threshold"],
  "output": "jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/.tmp-*/**",
    "**/.mimosa/**",
    "**/openfront-engine/**",
    "**/openfront-helper.autobot.js",
    "**/openfront-helper.user.js",
    "**/jscpd-report/**",
    "**/coverage/**",
    "**/dist/**",
    "**/build/**"
  ],
  "absolute": true
}
