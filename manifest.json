{
  "manifest_version": 3,
  "name": "OpenFront Helper Local Loader",
  "version": "1.0.0",
  "description": "Loads and hot-reloads this checkout's OpenFront Helper build without a server.",
  "host_permissions": ["https://openfront.io/*"],
  "content_scripts": [
    {
      "matches": ["https://openfront.io/*"],
      "js": ["openfront-helper-local-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://openfront.io/*"],
      "js": ["openfront-helper-local-poller.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "openfront-helper.build-id.js",
        "openfront-helper.user.js",
        "openfront-helper.autobot.js"
      ],
      "matches": ["https://openfront.io/*"]
    }
  ]
}
